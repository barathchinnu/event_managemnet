# CIVISTA 2026 — Environment Variables
# Copy this file to .env and fill in your real values

# ─── Google Apps Script Web App URL ─────────────────────────────────────────
# Get this after deploying the Code.gs file from google-apps-script/Code.gs
# Deploy as: Execute as Me, Who has access: Anyone
VITE_GOOGLE_SHEETS_API_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID_HERE/exec

# ─── Google Sheet ID (for direct download link) ─────────────────────────────
# Found in the Google Sheet URL:
# https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
VITE_GOOGLE_SHEETS_ID=YOUR_GOOGLE_SHEET_ID_HERE
